# Semantic Dictionary submission metadata
# Copy this file to .env (gitignored) and fill in your values.
# Used by src/build/export_semantics.py when generating SD submission artifacts.

# Responsible PM listed in doc/model/snowflake/*/readme.md stubs
SD_PM=Firstname Lastname

# Maintainer listed in doc/model/snowflake/*/readme.md stubs
SD_MAINTAINER=Firstname Lastname

# Space-separated list of Bitbucket user IDs for the OWNERS file section
SD_OWNERS=user.one user.two user.three
